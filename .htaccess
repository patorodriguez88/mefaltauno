DirectoryIndex index.php index.html
Options -Indexes

# Archivos que nunca se sirven
<FilesMatch "^(config(\.sample)?\.php|README\.md|\.ftp-deploy-sync-state\.json)$">
    Require all denied
</FilesMatch>

# Entorno de desarrollo: que los buscadores no lo indexen (quitar al lanzar).
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
